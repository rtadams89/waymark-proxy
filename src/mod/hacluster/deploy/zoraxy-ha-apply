#!/bin/bash
# zoraxy-ha-apply (custom fork): builds /etc/keepalived/keepalived.conf from
# the HA settings Zoraxy writes, then tests and reloads keepalived.
#
# Runs as root, started by zoraxy-ha-apply.path when Zoraxy saves
# /var/lib/zoraxy/ha/cluster.env. Zoraxy runs as an unprivileged user, so
# everything it writes is treated as untrusted:
#   - the settings file must be a regular file (not a symlink) owned by the
#     zoraxy user, and small
#   - only known keys are accepted, and every value is checked against a
#     strict pattern; nothing is ever evaluated as shell code
#   - the generated config uses a fixed template whose scripts are
#     root-owned files in /usr/local/lib/zoraxy-ha and run as the zoraxy
#     user (enable_script_security), so Zoraxy cannot make keepalived run
#     anything as root
#   - error messages name the setting, never echo its value
# The result is written to /var/lib/zoraxy-ha/result (root-owned folder,
# readable by the zoraxy group). The new config is tested with
# "keepalived -t" first; if keepalived does not come up with it, the
# previous config is restored (or keepalived is stopped if there is none).
#
# keepalived runs only while HA is on: turning HA off stops and disables it
# (keepalived with no VRRP instance never reports ready to systemd, so it
# would hang its start for 90 seconds). systemd ignores changes to the
# settings file while this helper runs, so after each apply it checks
# whether Zoraxy saved again in the meantime and applies that too.
set -uo pipefail
umask 022

HA_DIR="${HA_DIR:-/var/lib/zoraxy/ha}"
STATE_DIR="${HA_STATE_DIR:-/var/lib/zoraxy-ha}"
CONF="${KEEPALIVED_CONF:-/etc/keepalived/keepalived.conf}"
SCRIPTS="${HA_SCRIPTS_DIR:-/usr/local/lib/zoraxy-ha}"
OWNER="${HA_OWNER:-zoraxy}"
SETTINGS="$HA_DIR/cluster.env"

apply_id=0

result() { # status message
	local tmp
	tmp="$(mktemp "$STATE_DIR/.result.XXXXXX")" || exit 1
	printf 'APPLY_ID=%s\nSTATUS=%s\nTIME=%s\nMESSAGE=%s\n' "$apply_id" "$1" "$(date +%s)" "$2" >"$tmp"
	chmod 0640 "$tmp"
	chgrp "$OWNER" "$tmp" 2>/dev/null || true
	mv -f "$tmp" "$STATE_DIR/result"
}
fail() { result error "$1"; echo "zoraxy-ha-apply: $1" >&2; exit 1; }

is_ipv4() {
	local ip="$1" o
	[[ "$ip" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
	for o in "${BASH_REMATCH[@]:1}"; do
		[[ "$o" =~ ^(0|[1-9][0-9]*)$ ]] && [ "$o" -le 255 ] || return 1
	done
}
in_range() { # value min max
	[[ "$1" =~ ^[0-9]{1,6}$ ]] && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}

# systemctl with a time limit (a stuck start must not hang this helper)
svc() {
	[ -n "${HA_SKIP_SYSTEMCTL:-}" ] && return 0
	timeout "${HA_SYSTEMCTL_TIMEOUT:-20}" systemctl "$@"
}
keepalived_active() {
	[ -n "${HA_SKIP_SYSTEMCTL:-}" ] && return 0
	systemctl is-active --quiet keepalived
}

apply_once() {
# ---- Read the settings file safely ----
[ -d "$STATE_DIR" ] || { echo "zoraxy-ha-apply: $STATE_DIR is missing; run install.sh" >&2; exit 1; }
[ -e "$SETTINGS" ] || fail "no settings file yet"
[ -L "$SETTINGS" ] && fail "settings file must not be a symlink"
[ -f "$SETTINGS" ] || fail "settings file is not a regular file"
[ "$(stat -c %U "$SETTINGS")" = "$OWNER" ] || fail "settings file is not owned by $OWNER"
[ "$(stat -c %s "$SETTINGS")" -le 4096 ] || fail "settings file is too large"

declare -A cfg=()
while IFS= read -r line || [ -n "$line" ]; do
	line="${line%$'\r'}"
	case "$line" in '' | '#'*) continue ;; esac
	[[ "$line" == *=* ]] || fail "malformed line in settings file"
	key="${line%%=*}"
	val="${line#*=}"
	case "$key" in
	APPLY_ID | ENABLED | NODE_NAME | INTERFACE | LOCAL_IP | PEER_IPS | VIP | PREFIX | ROUTER_ID | PRIORITY | PASSWORD | PREEMPT) ;;
	*) fail "unknown setting in settings file" ;;
	esac
	[ -z "${cfg[$key]+x}" ] || fail "duplicate setting $key"
	cfg[$key]="$val"
	# Pick up the apply ID early so later errors are matched to this save
	if [ "$key" = APPLY_ID ] && [[ "$val" =~ ^[0-9]{1,20}$ ]]; then apply_id="$val"; fi
done <"$SETTINGS"

[[ "${cfg[APPLY_ID]:-}" =~ ^[0-9]{1,20}$ ]] || fail "APPLY_ID is invalid"
apply_id="${cfg[APPLY_ID]}"
[[ "${cfg[ENABLED]:-}" =~ ^[01]$ ]] || fail "ENABLED must be 0 or 1"
[[ "${cfg[NODE_NAME]:-}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || fail "NODE_NAME is invalid"
node="${cfg[NODE_NAME]}"

header="# Generated by zoraxy-ha-apply from Zoraxy's HA settings. Do not edit:
# changes are overwritten the next time HA settings are saved in Zoraxy."

if [ "${cfg[ENABLED]}" = "1" ]; then
	[[ "${cfg[INTERFACE]:-}" =~ ^[A-Za-z0-9._-]{1,15}$ ]] || fail "INTERFACE is invalid"
	iface="${cfg[INTERFACE]}"
	if [ -z "${HA_SKIP_IFCHECK:-}" ]; then
		[ -d "/sys/class/net/$iface" ] || fail "network interface $iface does not exist on this node"
	fi
	is_ipv4 "${cfg[LOCAL_IP]:-}" || fail "LOCAL_IP is not an IPv4 address"
	local_ip="${cfg[LOCAL_IP]}"
	if [ -z "${HA_SKIP_IFCHECK:-}" ]; then
		ip -4 -o addr show dev "$iface" | grep -qE "inet ${local_ip//./\\.}/" ||
			fail "address $local_ip is not assigned to $iface on this node"
	fi
	[[ "${cfg[PEER_IPS]:-}" =~ ^[0-9.,]{7,64}$ ]] || fail "PEER_IPS is invalid"
	IFS=',' read -r -a peers <<<"${cfg[PEER_IPS]}"
	[ "${#peers[@]}" -ge 1 ] && [ "${#peers[@]}" -le 3 ] || fail "PEER_IPS must list 1 to 3 addresses"
	for p in "${peers[@]}"; do
		is_ipv4 "$p" || fail "PEER_IPS contains an invalid address"
		[ "$p" != "$local_ip" ] || fail "PEER_IPS must not contain this node's address"
	done
	is_ipv4 "${cfg[VIP]:-}" || fail "VIP is not an IPv4 address"
	vip="${cfg[VIP]}"
	in_range "${cfg[PREFIX]:-}" 1 32 || fail "PREFIX must be 1-32"
	in_range "${cfg[ROUTER_ID]:-}" 1 255 || fail "ROUTER_ID must be 1-255"
	in_range "${cfg[PRIORITY]:-}" 1 254 || fail "PRIORITY must be 1-254"
	[[ "${cfg[PASSWORD]:-}" =~ ^[A-Za-z0-9]{0,8}$ ]] || fail "PASSWORD must be up to 8 letters or digits"
	[[ "${cfg[PREEMPT]:-}" =~ ^[01]$ ]] || fail "PREEMPT must be 0 or 1"

	peer_lines=""
	for p in "${peers[@]}"; do peer_lines+="        $p"$'\n'; done
	auth=""
	if [ -n "${cfg[PASSWORD]}" ]; then
		auth="    authentication {
        auth_type PASS
        auth_pass ${cfg[PASSWORD]}
    }
"
	fi
	preempt="    nopreempt"
	[ "${cfg[PREEMPT]}" = "1" ] && preempt="    preempt_delay 30"

	config="$header

global_defs {
    router_id zoraxy_$node
    enable_script_security
    script_user $OWNER
}

vrrp_script zoraxy_health {
    script \"$SCRIPTS/check\"
    interval 2
    timeout 2
    fall 2
    rise 2
}

vrrp_instance ZORAXY {
    state BACKUP
    interface $iface
    virtual_router_id ${cfg[ROUTER_ID]}
    priority ${cfg[PRIORITY]}
    advert_int 1
$preempt
    unicast_src_ip $local_ip
    unicast_peer {
$peer_lines    }
${auth}    virtual_ipaddress {
        $vip/${cfg[PREFIX]} dev $iface
    }
    track_script {
        zoraxy_health
    }
    notify \"$SCRIPTS/notify\"
    notify_stop \"$SCRIPTS/notify INSTANCE ZORAXY STOP\"
}
"
else
	config="$header
# HA is turned off in Zoraxy: keepalived is stopped and no floating IP is managed on this node.

global_defs {
    router_id zoraxy_$node
    enable_script_security
    script_user $OWNER
}
"
fi

# ---- Test, install, reload ----
conf_dir="$(dirname "$CONF")"
mkdir -p "$conf_dir"
tmp="$(mktemp "$conf_dir/.keepalived.conf.XXXXXX")" || fail "could not write to $conf_dir"
printf '%s' "$config" >"$tmp"
chmod 0644 "$tmp"
if ! out="$(keepalived -t -f "$tmp" 2>&1)"; then
	rm -f "$tmp"
	fail "keepalived rejected the generated config: $(echo "$out" | tr '\n' ' ' | cut -c1-300)"
fi

had_prev=0
if [ -f "$CONF" ]; then
	if ! head -n1 "$CONF" | grep -q '^# Generated by zoraxy-ha-apply'; then
		cp -p "$CONF" "$CONF.pre-zoraxy" 2>/dev/null || true # keep a hand-written config once
	fi
	cp -p "$CONF" "$CONF.zoraxy-prev"
	# Only a config with a VRRP instance is worth going back to
	grep -q '^vrrp_instance' "$CONF.zoraxy-prev" && had_prev=1
fi
mv -f "$tmp" "$CONF"

if [ "${cfg[ENABLED]}" != "1" ]; then
	svc disable --now keepalived >/dev/null 2>&1 || true
	if [ -z "${HA_SKIP_SYSTEMCTL:-}" ] && systemctl is-active --quiet keepalived; then
		fail "HA turned off, but keepalived could not be stopped (see journalctl -u keepalived)"
	fi
	result ok "HA turned off: keepalived stopped and disabled on node $node"
	return 0
fi

svc enable keepalived >/dev/null 2>&1 || true
if keepalived_active && [ -z "${HA_SKIP_SYSTEMCTL:-}" ]; then
	action=reload
else
	action=restart
fi
ok=0
if svc "$action" keepalived; then
	[ "$action" = reload ] && sleep 1
	keepalived_active && ok=1
fi
if [ "$ok" != 1 ]; then
	if [ "$had_prev" = 1 ]; then
		cp -p "$CONF.zoraxy-prev" "$CONF"
		svc restart keepalived || svc stop keepalived || true
		fail "keepalived did not start with the new config (see journalctl -u keepalived); the previous config was restored"
	fi
	svc stop keepalived || true
	fail "keepalived did not start with the new config (see journalctl -u keepalived); keepalived is stopped"
fi
result ok "keepalived config applied for node $node"
}

# Apply, then again if Zoraxy saved newer settings while this was running
status=0
for _ in 1 2 3 4 5; do
	( apply_once )
	status=$?
	[ -L "$SETTINGS" ] && break
	want="$(grep -m1 -E '^APPLY_ID=[0-9]{1,20}$' "$SETTINGS" 2>/dev/null | cut -d= -f2)"
	done_id="$(grep -m1 -E '^APPLY_ID=' "$STATE_DIR/result" 2>/dev/null | cut -d= -f2)"
	[ -n "$want" ] && [ "$want" != "$done_id" ] || break
done
exit "$status"
